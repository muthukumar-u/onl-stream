# Example only: keep the fake key here when sharing this kit.
# During setup, edit /etc/youtube-stream/stream.env on your server instead.
# Replace YOUR_STREAM_KEY there with the private key from YouTube Studio.
# This tells the sender where to send the video and which channel may receive it.
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com:443/live2/YOUR_STREAM_KEY
